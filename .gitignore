dist/

# Original, intermediate and complete processed data
/data/raw/*
!/data/raw/.gitkeep
/data/interim/*
!/data/interim/.gitkeep
/data/processed/*
!/data/processed/.gitkeep
/data/reference/

# Models and experiment outputs; approved reports are stored in reports/
/artifacts/*
!/artifacts/.gitkeep
*.log

# data/shared/ and data/sample/ are intentionally not globally ignored.
# Only reviewed datasets and synthetic examples should be added to Git.

